# Copy this file to `.env.local` and fill in your own values.
# Find both in your Supabase dashboard: Project Settings -> API
#
# These are PUBLIC values, safe to expose in the browser. Row Level Security
# is what protects your data -- see supabase/migrations/001_schema.sql.
#
# Never put the `service_role` key here. It bypasses all security rules.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
